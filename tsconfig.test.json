{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": false,
    "types": ["jest", "node"]
  },
  "include": ["src"]
}
